# Content bot (cmd/bot). Copy to .env.bot.
#
# Separate from the API's .env because the bot shares none of its configuration
# and may run on another host. Precedence: .env.bot > environment > .env, so .env
# still fills in what this file omits — but keep each variable in one file only,
# or the losing copy looks set and never applies.
#
# Only credentials and an address live here. Interval, persona count, model chain,
# personas, topics and the generation knobs (prompt template, temperature, max
# tags, repetition-guard depth, the two HTTP timeouts) are served by GET /bot/plan
# and edited through /admin/bots, so the bot picks them up on its next tick.
# BOT_ACCOUNTS, BOT_POST_INTERVAL and GEMINI_MODELS are no longer read.

# Separate from the API's — the only variable both processes name identically.
LOG_LEVEL=info

# Compose overrides this to http://app:8080/api/v1: inside a container localhost
# is the container itself.
BOT_API_BASE_URL=http://localhost:8080/api/v1

# Shared by every persona account, which the bot registers on first use. Required,
# with no default on purpose: a default here would be a live credential published
# in the repo. Generate one, e.g. `openssl rand -base64 18`.
# BOT_PASSWORD=

# The runner reads the plan and reports runs. It must already exist and hold the
# 'bot' role — the bot never registers it, so a missing one 403s every plan fetch:
#   make ctl CTL_ARGS="user create -username bot_runner -email bot_runner@bot.local"
#   make ctl CTL_ARGS="user grant-role -username bot_runner -role bot"
BOT_RUNNER_USERNAME=bot_runner
# BOT_RUNNER_PASSWORD=  # required

# Required. Gemini quota is per-model per-day; the fallback chain lives in
# /admin/bots/config.
# GEMINI_API_KEY=your-ai-studio-api-key

# Override the endpoint — for a proxy or a local mock.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
