# Copy to .env.backup on the deployment host. dv reads this after .env/.env.app.
# Only pg-backup receives these credentials; never commit .env.backup.
BACKUP_RESTIC_REPOSITORY=s3:https://s3.example.com/darkvoid-backups/production
BACKUP_RESTIC_PASSWORD=replace-with-an-independent-long-secret
BACKUP_ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/darkvoid-backup
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_SESSION_TOKEN=
BACKUP_AWS_REGION=us-east-1
# To isolate restore I/O from production, supply a scratch PostgreSQL endpoint.
# BACKUP_RESTORE_PGHOST=
# BACKUP_RESTORE_PGPORT=5432
# BACKUP_RESTORE_PGUSER=
# BACKUP_RESTORE_PGPASSWORD=
