# ---------------------------------------------------------------------------
# DarkVoid environment template
# Copy to .env for local development. Do not commit real secrets.
# ---------------------------------------------------------------------------

# Application
SERVICE_NAME=darkvoid
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# Logger
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=false

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s
SERVER_REQUEST_TIMEOUT=60s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Database
# When running the app on the host, DB_HOST should usually be localhost.
# Docker Compose overrides DB_HOST to the postgres service name automatically.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=darkvoid
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
# No DATABASE_URL: the migrate CLI is the only thing that ever wanted a single
# URL, and the Makefile now derives its connection from the DB_* values above
# (via PG*), so there is nothing to keep in sync. See `make migrate-up`.

# Docker Compose profiles — picked up automatically by every `docker compose`
# call (and the make docker-* targets), no --profile flag needed.
#   codohue  — CF recommender stack     external — app-only mode
#   tools    — seed runner + ctl        bot      — AI content bot
#   backup   — pg_dump one-shot (docker-compose.prod.yml only)
# Example: COMPOSE_PROFILES=codohue  (comma-separate to combine)
# COMPOSE_PROFILES=

# Seed data volume (profile "tools"): make docker-seed
SEED_POSTS=500
SEED_LIKES_PER_POST=40
SEED_COMMENTS_PER_POST=5

# Optional host port overrides for docker-compose.override.yml
DB_EXPOSE_PORT=5433
REDIS_EXPOSE_PORT=6380
QDRANT_HTTP_PORT=6335
QDRANT_GRPC_PORT=6336
CODOHUE_EXPOSE_PORT=2001
CODOHUE_ADMIN_EXPOSE_PORT=2002

# App-only Docker mode (service app-external, profile "external"): make docker-up-app
# These are the addresses the app container uses to reach infra outside compose.
EXTERNAL_DB_HOST=host.docker.internal
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_SSLMODE=disable
EXTERNAL_REDIS_HOST=host.docker.internal
EXTERNAL_REDIS_PORT=6379
EXTERNAL_CODOHUE_BASE_URL=http://host.docker.internal:2001
EXTERNAL_CODOHUE_ADMIN_URL=http://host.docker.internal:2002

# ---------------------------------------------------------------------------
# Production deployment (docker-compose.prod.yml) — not needed for local dev.
#
# Every key below is optional: the compose file carries a working default for
# each one. They are listed commented-out on purpose, so the default lives in
# exactly one place. Uncomment only what a given deployment actually overrides,
# otherwise the two files drift and the .env silently wins.
# ---------------------------------------------------------------------------

# The `dv` wrapper passes the full -f list, so this is only for a bare
# `docker compose` on the deploy box. Overrides must be listed too:
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.codohue.yml

# Compose project name of the Codohue stack, when it runs as its own project and
# docker-compose.codohue.yml is in use. It is how that file finds both Codohue's
# network (<name>_default) and its Redis container (<name>-redis-1), so it must
# match the directory Codohue was deployed from.
# CODOHUE_STACK=codohue-dev

# Image to deploy. CD tags every build with its commit SHA as well as `latest`,
# so pinning APP_TAG to a SHA is the whole rollback procedure:
#   echo 'APP_TAG=<sha>' >> .env && dv up -d app
# APP_IMAGE=ghcr.io/jarviisha/darkvoid
# APP_TAG=latest

# Host interface the app publishes on. Default 0.0.0.0 exposes it on every
# interface; set 127.0.0.1 when a reverse proxy terminates traffic in front.
# SERVER_BIND=0.0.0.0

# Container memory ceilings. Their job is to make a leaking container die alone
# instead of letting the host OOM killer pick a victim — which is usually
# Postgres. Raise them rather than removing them if a service gets killed.
# APP_MEMORY_LIMIT=768m
# POSTGRES_MEMORY_LIMIT=1g
# REDIS_MEMORY_LIMIT=384m
# BOT_MEMORY_LIMIT=256m
# APP_PIDS_LIMIT=512

# Redis holds only derived data (following:ids, trending:posts) plus the
# notification pub/sub channel, so it is capped and evicts LRU. Keep this
# comfortably under REDIS_MEMORY_LIMIT: eviction should reclaim memory before
# the OOM killer does, and a background RDB save needs copy-on-write headroom.
# REDIS_MAXMEMORY=256mb

# Dumps to keep in the pg_backups volume (profile "backup"). Older ones are
# pruned after each run. Note the volume lives on the same host as the database —
# copy the dumps off the box for this to count as a real backup.
# BACKUP_KEEP=14

# Docker network name. Server-local override files join by this name, so it is
# fixed rather than the generated <project>_default, which changes with the
# deployment directory.
# COMPOSE_NETWORK_NAME=darkvoid

# JWT and refresh tokens
# Production must set JWT_SECRET to a strong random value.
JWT_SECRET=change-this-secret-key-in-production-use-at-least-32-characters
JWT_ISSUER=darkvoid
JWT_ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# Storage
STORAGE_PROVIDER=local
STORAGE_BASE_URL=http://localhost:8080/static
STORAGE_LOCAL_DIR=./uploads
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=darkvoid
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_USE_SSL=false

# Root bootstrap
# Leave ROOT_EMAIL or ROOT_PASSWORD empty to disable automatic root creation.
# When enabled, the root account is granted the "admin" role on every boot so
# the admin API (/api/v1/admin) and /swagger/admin/ are usable immediately.
ROOT_EMAIL=
ROOT_PASSWORD=
ROOT_USERNAME=root
ROOT_DISPLAY_NAME=Root Admin

# Redis
# Docker Compose enables Redis for the app container automatically.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Feed timeline rollout and fanout
# Timeline serving is off by default. Fanout may prepare timelines before serving.
FEED_TIMELINE_ENABLED=false
FEED_TIMELINE_ROLLOUT_PERCENT=0
FEED_TIMELINE_MAX_ITEMS=1000
FEED_TIMELINE_TTL=168h
FEED_FANOUT_ENABLED=true
FEED_FANOUT_WORKERS=10
FEED_FANOUT_QUEUE_SIZE=10000
FEED_FANOUT_MAX_FOLLOWERS=10000
FEED_TIMELINE_REFRESH_ON_MISS=true

# Codohue personalization service
# Enable only when running the codohue profile: make docker-up-codohue
# Codohue v0.4+ splits into a data-plane API (cmd/api, port 2001) and an
# admin plane (cmd/admin, port 2002). Runtime calls use CODOHUE_BASE_URL;
# namespace provisioning at boot uses CODOHUE_ADMIN_URL + CODOHUE_ADMIN_KEY.
CODOHUE_ENABLED=false
CODOHUE_BASE_URL=http://localhost:2001
CODOHUE_ADMIN_URL=http://localhost:2002
# CODOHUE_DOCKER_BASE_URL=http://codohue-api:2001
# CODOHUE_DOCKER_ADMIN_URL=http://codohue-admin:2002
CODOHUE_NAMESPACE=darkvoid_feed
CODOHUE_EMBEDDING_DIM=64
# Who produces object (post) vectors:
#   byoe    — darkvoid computes TF-IDF locally and pushes vectors (default)
#   catalog — post content is sent raw; Codohue embeds it server-side
#             (hashing n-grams; requires the codohue-embedder container and
#              CODOHUE_EMBEDDING_DIM in {64,128,256,512})
CODOHUE_DENSE_SOURCE=byoe
# CODOHUE_NAMESPACE_KEY=
# CODOHUE_ADMIN_KEY=
# CODOHUE_API_KEY=
# Which Redis *Codohue's own containers* connect to. Read by docker-compose.yml,
# not by darkvoid. Only needed when REDIS_PASSWORD is set, since the compose
# default carries no credential:
# CODOHUE_REDIS_URL=redis://:yourpassword@redis:6379
#
# Which Redis *darkvoid* publishes behavior events to. Read by the app; note this
# is a different question from CODOHUE_REDIS_URL above, and both must name the
# same server — Codohue's consumer only sees the stream on the Redis it reads.
#
# Leave the host unset when one Redis serves both sides (the local-dev layout,
# where Codohue runs as a profile inside this stack and uses darkvoid's Redis).
# The producer then shares the app's client and the vars below are ignored.
#
# Set it when Codohue owns a separate Redis. The alternative — pointing REDIS_HOST
# at Codohue's instance — also delivers events, but it moves the feed cache, the
# timeline store, and the notification pub/sub onto a server darkvoid does not
# own, so an outage in an optional integration takes core features down with it.
# CODOHUE_EVENTS_REDIS_HOST=
# CODOHUE_EVENTS_REDIS_PORT=6379
# CODOHUE_EVENTS_REDIS_PASSWORD=
# CODOHUE_EVENTS_REDIS_DB=0
# Signing key for codohue-admin sessions. Left empty it is generated per boot,
# so every restart of the admin container logs operators out. Pin it in any
# deployment you actually log into: `openssl rand -base64 32`.
# CODOHUE_ADMIN_SESSION_SECRET=

# Content bot (cmd/bot) — posts AI-generated content against a running API.
#
# Only credentials and an address live here. Post interval, how many personas are
# active, the Gemini model fallback chain, the personas, and the topic pool are all
# served by GET /bot/plan and edited through /admin/bots, so the bot picks up a
# change on its next tick with no restart. BOT_ACCOUNTS, BOT_POST_INTERVAL, and
# GEMINI_MODELS are no longer read — set them in the admin panel instead.
#
# The generation knobs are there too, and were never environment variables: the
# prompt template, temperature, max tags per post, how many recent posts feed the
# repetition guard, and the bot's two HTTP timeouts. They live in bot.config and are
# edited through PATCH /admin/bots/config. Do not add them here — a value in two
# places is a value that disagrees with itself.
BOT_API_BASE_URL=http://localhost:8080/api/v1

# Shared by every persona account, which the bot registers on first use. Required,
# and deliberately without a default: a default here would be a live credential
# published in the repository, usable by anyone who reads it to log in as a persona
# and post as it. Generate one, e.g. `openssl rand -base64 18`.
# BOT_PASSWORD=

# The runner account reads the plan and reports runs. It must already exist and hold
# the 'bot' role — the bot never registers it, because an auto-created account would
# lack the role and every plan fetch would 403 for no visible reason. To set it up:
#
#   make ctl CTL_ARGS="user create -username bot_runner -email bot_runner@bot.local"
#   make ctl CTL_ARGS="user grant-role -username bot_runner -role bot"
#
# create prompts for the password; put it in BOT_RUNNER_PASSWORD below.
BOT_RUNNER_USERNAME=bot_runner
# BOT_RUNNER_PASSWORD=  # required to run the bot

# Required to run the bot. Gemini quota is per-model per-day; the fallback chain in
# /admin/bots/config decides which model is tried first and what it rotates to.
# GEMINI_API_KEY=your-ai-studio-api-key

# Override the Gemini endpoint — for a proxy or a local mock in tests.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Mailer
# nop | resend | smtp. Use nop locally unless you need to test real delivery.
# A provider that is named but unconfigured fails at startup rather than
# silently degrading to nop — a mailer that logs instead of sending looks
# healthy while every verification and reset email disappears.
MAILER_PROVIDER=nop

# From address and the app URL used to build links in emails. Both apply to
# every provider.
# MAILER_FROM=DarkVoid <noreply@darkvoid.app>
# MAILER_BASE_URL=http://localhost:3000

# resend: the API key from resend.com/api-keys. The sending domain in
# MAILER_FROM must be verified there (SPF + DKIM records) or every send is
# rejected with 403; onboarding@resend.dev only delivers to the account owner.
# RESEND_API_KEY=re_your_api_key

# Signing secret for the Resend webhook, from the webhook's settings page.
# POST /api/v1/webhooks/resend is only registered when this is set — the Svix
# signature is that route's only authentication, and an unverified endpoint that
# writes to the suppression list would let anyone block any address.
# Without it, delivery reports never arrive: bounces and spam complaints go
# unnoticed and nothing is ever suppressed.
# RESEND_WEBHOOK_SECRET=whsec_your_signing_secret

# smtp only — ignored by the other providers.
# MAILER_HOST=smtp.gmail.com
# MAILER_PORT=587
# MAILER_USERNAME=your-email@example.com
# MAILER_PASSWORD=your-app-password
