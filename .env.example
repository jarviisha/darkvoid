# DarkVoid environment template. Copy to .env. Do not commit real secrets.
# Rationale for the non-obvious keys lives in CLAUDE.md > Configuration.
# The content bot is configured separately — see .env.bot.example.

# Application
SERVICE_NAME=darkvoid
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# Logger
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=false

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s
SERVER_REQUEST_TIMEOUT=60s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Refresh token cookie. Path and HttpOnly are not configurable — see CLAUDE.md.
# COOKIE_SAMESITE: lax (frontend and API on the same registrable domain) |
#   strict | none (frontend on a different domain; requires a secure cookie).
# COOKIE_DOMAIN: empty = host-only. Set to share across subdomains, bare
#   hostname only (example.com, not https://example.com:8443).
# COOKIE_SECURE: unset = true unless ENVIRONMENT=development. Set it explicitly
#   for a non-production deployment that still terminates TLS.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
# COOKIE_SECURE=

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Database. Compose overrides DB_HOST to the postgres service name.
# There is deliberately no DATABASE_URL — `make migrate-up` derives the migrate
# CLI's connection from these via PG*.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=darkvoid
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# JWT and refresh tokens. Production must set a strong random JWT_SECRET.
JWT_SECRET=change-this-secret-key-in-production-use-at-least-32-characters
JWT_ISSUER=darkvoid
JWT_ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# Redis — required, no REDIS_ENABLED: the API refuses to boot without one.
# Defaults describe `make docker-up`'s Redis reached from the host.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Storage
STORAGE_PROVIDER=local
STORAGE_BASE_URL=http://localhost:8080/static
STORAGE_LOCAL_DIR=./uploads
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=darkvoid
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_USE_SSL=false

# Root bootstrap. Empty ROOT_EMAIL or ROOT_PASSWORD disables it; otherwise the
# account is granted the admin role on every boot.
ROOT_EMAIL=
ROOT_PASSWORD=
ROOT_USERNAME=root
ROOT_DISPLAY_NAME=Root Admin

# Feed fanout sizing — allocated at construction, so restart-only. The rest of
# the FEED_* group (timeline, rollout, fanout switches, ranking weights) is no
# longer read here: it lives in settings.feed, via PATCH /admin/settings/feed.
FEED_FANOUT_WORKERS=10
FEED_FANOUT_QUEUE_SIZE=10000

# How often each instance re-reads settings.feed.
SETTINGS_REFRESH_INTERVAL=30s

# Mailer: nop | resend | smtp. A named-but-unconfigured provider fails at
# startup rather than degrading to nop.
MAILER_PROVIDER=nop
# MAILER_FROM=DarkVoid <noreply@darkvoid.app>
# MAILER_BASE_URL=http://localhost:3000

# resend: the sending domain in MAILER_FROM must be verified (SPF + DKIM) or
# every send returns 403; onboarding@resend.dev only delivers to the account owner.
# RESEND_API_KEY=re_your_api_key

# Signing secret from the webhook's settings page. POST /api/v1/webhooks/resend
# is not registered without it — the Svix signature is that route's only auth —
# so bounces and complaints go unnoticed and nothing is ever suppressed.
# RESEND_WEBHOOK_SECRET=whsec_your_signing_secret

# smtp only — ignored by the other providers.
# MAILER_HOST=smtp.gmail.com
# MAILER_PORT=587
# MAILER_USERNAME=your-email@example.com
# MAILER_PASSWORD=your-app-password

# ---------------------------------------------------------------------------
# Codohue personalization service — external, always. This project runs no part
# of it; deploy it from its own compose project and point these at it.
# ---------------------------------------------------------------------------
# Data plane (port 2001) serves runtime calls; admin plane (2002) provisions the
# namespace at boot.
CODOHUE_ENABLED=false
CODOHUE_BASE_URL=http://localhost:2001
CODOHUE_ADMIN_URL=http://localhost:2002
# The two above are the host's point of view. The app, seed and ctl containers
# override them, defaulting to host.docker.internal; set these to change that.
# CODOHUE_DOCKER_BASE_URL=
# CODOHUE_DOCKER_ADMIN_URL=
CODOHUE_NAMESPACE=darkvoid_feed
CODOHUE_EMBEDDING_DIM=64
# Who produces post vectors: byoe (darkvoid computes TF-IDF locally) or catalog
# (Codohue embeds server-side; needs its embedder worker and DIM in 64/128/256/512).
CODOHUE_DENSE_SOURCE=byoe
# CODOHUE_NAMESPACE_KEY=
# CODOHUE_ADMIN_KEY=
# CODOHUE_API_KEY=

# Which Redis behavior events are XADDed to. Codohue's consumer reads
# codohue:events from the Redis *it* owns, so events published anywhere else are
# never seen. Leave the host unset when one Redis serves both sides; set it when
# Codohue owns a separate one (don't repoint REDIS_HOST — that moves our feed
# cache, timeline and pub/sub onto a server darkvoid does not own).
# CODOHUE_EVENTS_REDIS_HOST=
# CODOHUE_EVENTS_REDIS_PORT=6379
# CODOHUE_EVENTS_REDIS_PASSWORD=
# CODOHUE_EVENTS_REDIS_DB=0

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------
# Profiles are picked up automatically by every compose call, no --profile flag:
#   external — app-only mode    bot — AI content bot
#   tools    — seed + ctl       backup — pg_dump one-shot (prod only)
# COMPOSE_PROFILES=

# Seed data volume (profile "tools"): make docker-seed
SEED_POSTS=500
SEED_LIKES_PER_POST=40
SEED_COMMENTS_PER_POST=5

# Host port overrides for docker-compose.override.yml
DB_EXPOSE_PORT=5433
REDIS_EXPOSE_PORT=6380

# App-only mode (profile "external"): how the app container reaches outside infra.
EXTERNAL_DB_HOST=host.docker.internal
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_SSLMODE=disable
EXTERNAL_REDIS_HOST=host.docker.internal
EXTERNAL_REDIS_PORT=6379
EXTERNAL_CODOHUE_BASE_URL=http://host.docker.internal:2001
EXTERNAL_CODOHUE_ADMIN_URL=http://host.docker.internal:2002

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml) — not needed for local dev.
# Every key below already has a working default in the compose file. Uncomment
# only what a deployment overrides, or the two drift and .env silently wins.
# ---------------------------------------------------------------------------

# Only for a bare `docker compose` on the deploy box; the `dv` wrapper passes -f.
# COMPOSE_FILE=docker-compose.prod.yml:docker-compose.codohue.yml

# Compose project name of the Codohue stack — how docker-compose.codohue.yml
# finds its network (<name>_default) and Redis (<name>-redis-1).
# CODOHUE_STACK=codohue-dev

# Pinning APP_TAG to a commit SHA is the whole rollback procedure.
# APP_IMAGE=ghcr.io/jarviisha/darkvoid
# APP_TAG=latest

# Host interface the app publishes on. Use 127.0.0.1 behind a reverse proxy.
# SERVER_BIND=0.0.0.0

# Memory ceilings make a leaking container die alone instead of letting the host
# OOM killer pick a victim, usually Postgres. Raise, don't remove.
# APP_MEMORY_LIMIT=768m
# POSTGRES_MEMORY_LIMIT=1g
# REDIS_MEMORY_LIMIT=384m
# BOT_MEMORY_LIMIT=256m
# APP_PIDS_LIMIT=512

# Keep under REDIS_MEMORY_LIMIT — eviction should reclaim memory before the OOM
# killer does, and a background RDB save needs copy-on-write headroom.
# REDIS_MAXMEMORY=256mb

# Dumps kept in the pg_backups volume (profile "backup"), on the database's own
# host — copy them off the box for this to count as a real backup.
# BACKUP_KEEP=14

# Fixed rather than the generated <project>_default, which changes with the
# deployment directory. Server-local override files join by this name.
# COMPOSE_NETWORK_NAME=darkvoid
