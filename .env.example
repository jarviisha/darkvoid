# ---------------------------------------------------------------------------
# DarkVoid environment template
# Copy to .env for local development. Do not commit real secrets.
# ---------------------------------------------------------------------------

# Application
SERVICE_NAME=darkvoid
SERVICE_VERSION=1.0.0
ENVIRONMENT=development

# Logger
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=false

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=120s
SERVER_REQUEST_TIMEOUT=60s
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Database
# When running the app on the host, DB_HOST should usually be localhost.
# Docker Compose overrides DB_HOST to the postgres service name automatically.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=darkvoid
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DATABASE_URL=postgres://postgres:postgres@localhost:5432/darkvoid?sslmode=disable

# Docker Compose profiles — picked up automatically by every `docker compose`
# call (and the make docker-* targets), no --profile flag needed.
#   codohue  — CF recommender stack     external — app-only mode
#   tools    — seed runner
# Example: COMPOSE_PROFILES=codohue  (comma-separate to combine)
# COMPOSE_PROFILES=

# Optional host port overrides for docker-compose.override.yml
DB_EXPOSE_PORT=5433
REDIS_EXPOSE_PORT=6380
QDRANT_HTTP_PORT=6335
QDRANT_GRPC_PORT=6336
CODOHUE_EXPOSE_PORT=2001
CODOHUE_ADMIN_EXPOSE_PORT=2002

# App-only Docker mode (service app-external, profile "external"): make docker-up-app
# These are the addresses the app container uses to reach infra outside compose.
EXTERNAL_DB_HOST=host.docker.internal
EXTERNAL_DB_PORT=5432
EXTERNAL_DB_SSLMODE=disable
EXTERNAL_REDIS_HOST=host.docker.internal
EXTERNAL_REDIS_PORT=6379
EXTERNAL_CODOHUE_BASE_URL=http://host.docker.internal:2001
EXTERNAL_CODOHUE_ADMIN_URL=http://host.docker.internal:2002

# JWT and refresh tokens
# Production must set JWT_SECRET to a strong random value.
JWT_SECRET=change-this-secret-key-in-production-use-at-least-32-characters
JWT_ISSUER=darkvoid
JWT_ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# Storage
STORAGE_PROVIDER=local
STORAGE_BASE_URL=http://localhost:8080/static
STORAGE_LOCAL_DIR=./uploads
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=darkvoid
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_USE_SSL=false

# Root bootstrap
# Leave ROOT_EMAIL or ROOT_PASSWORD empty to disable automatic root creation.
# When enabled, the root account is granted the "admin" role on every boot so
# the admin API (/api/v1/admin) and /swagger/admin/ are usable immediately.
ROOT_EMAIL=
ROOT_PASSWORD=
ROOT_USERNAME=root
ROOT_DISPLAY_NAME=Root Admin

# Redis
# Docker Compose enables Redis for the app container automatically.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Feed timeline rollout and fanout
# Timeline serving is off by default. Fanout may prepare timelines before serving.
FEED_TIMELINE_ENABLED=false
FEED_TIMELINE_ROLLOUT_PERCENT=0
FEED_TIMELINE_MAX_ITEMS=1000
FEED_TIMELINE_TTL=168h
FEED_FANOUT_ENABLED=true
FEED_FANOUT_WORKERS=10
FEED_FANOUT_QUEUE_SIZE=10000
FEED_FANOUT_MAX_FOLLOWERS=10000
FEED_TIMELINE_REFRESH_ON_MISS=true

# Codohue personalization service
# Enable only when running the codohue profile: make docker-up-codohue
# Codohue v0.4+ splits into a data-plane API (cmd/api, port 2001) and an
# admin plane (cmd/admin, port 2002). Runtime calls use CODOHUE_BASE_URL;
# namespace provisioning at boot uses CODOHUE_ADMIN_URL + CODOHUE_ADMIN_KEY.
CODOHUE_ENABLED=false
CODOHUE_BASE_URL=http://localhost:2001
CODOHUE_ADMIN_URL=http://localhost:2002
# CODOHUE_DOCKER_BASE_URL=http://codohue-api:2001
# CODOHUE_DOCKER_ADMIN_URL=http://codohue-admin:2002
CODOHUE_NAMESPACE=darkvoid_feed
CODOHUE_EMBEDDING_DIM=64
# Who produces object (post) vectors:
#   byoe    — darkvoid computes TF-IDF locally and pushes vectors (default)
#   catalog — post content is sent raw; Codohue embeds it server-side
#             (hashing n-grams; requires the codohue-embedder container and
#              CODOHUE_EMBEDDING_DIM in {64,128,256,512})
CODOHUE_DENSE_SOURCE=byoe
# CODOHUE_NAMESPACE_KEY=
# CODOHUE_ADMIN_KEY=
# CODOHUE_API_KEY=
# If REDIS_PASSWORD is set and Codohue runs in Docker, set this explicitly:
# CODOHUE_REDIS_URL=redis://:yourpassword@redis:6379

# Content bot (cmd/bot) — posts AI-generated content against a running API.
#
# Only credentials and an address live here. Post interval, how many personas are
# active, the Gemini model fallback chain, the personas, and the topic pool are all
# served by GET /bot/plan and edited through /admin/bots, so the bot picks up a
# change on its next tick with no restart. BOT_ACCOUNTS, BOT_POST_INTERVAL, and
# GEMINI_MODELS are no longer read — set them in the admin panel instead.
BOT_API_BASE_URL=http://localhost:8080/api/v1

# Shared by every persona account, which the bot registers on first use.
BOT_PASSWORD=Bot@12345

# The runner account reads the plan and reports runs. It must already exist and hold
# the 'bot' role — the bot never registers it, because an auto-created account would
# lack the role and every plan fetch would 403 for no visible reason. To set it up:
#
#   1. make ctl CTL_ARGS="user create -username bot_runner -email bot_runner@bot.local"
#      (prompts for the password; put it in BOT_RUNNER_PASSWORD below)
#   2. grant the role as an admin — darkvoidctl only handles the admin role today:
#      POST /api/v1/admin/users/{id}/roles  with  {"role":"bot"}
BOT_RUNNER_USERNAME=bot_runner
# BOT_RUNNER_PASSWORD=  # required to run the bot

# Required to run the bot. Gemini quota is per-model per-day; the fallback chain in
# /admin/bots/config decides which model is tried first and what it rotates to.
# GEMINI_API_KEY=your-ai-studio-api-key

# Mailer
# Use nop locally unless you need to test real delivery.
MAILER_PROVIDER=nop
# MAILER_HOST=smtp.gmail.com
# MAILER_PORT=587
# MAILER_USERNAME=your-email@example.com
# MAILER_PASSWORD=your-app-password
# MAILER_FROM=DarkVoid <your-email@example.com>
# MAILER_BASE_URL=http://localhost:3000
