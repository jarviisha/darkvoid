# systemd unit template for running the DarkVoid content bot on a VPS.
# Mirrors codohue's geminipump deployment: the bot is not part of the compose
# stack and is not published as an image — copy the static binary and this
# unit to the host, then enable it.
#
#   CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o tmp/darkvoid-bot ./cmd/bot
#   scp tmp/darkvoid-bot                VPS:/tmp/ && ssh VPS 'sudo install -m 755 /tmp/darkvoid-bot /usr/local/bin/'
#   scp cmd/bot/darkvoid-bot.service    VPS:/tmp/ && ssh VPS 'sudo install -m 644 /tmp/darkvoid-bot.service /etc/systemd/system/'
#   ssh VPS 'sudo install -m 600 /dev/stdin /etc/darkvoid-bot.env' <<'EOF'
#   GEMINI_API_KEY=your-ai-studio-api-key
#   BOT_PASSWORD=a-strong-generated-password
#   EOF
#   ssh VPS 'sudo systemctl daemon-reload && sudo systemctl enable --now darkvoid-bot'
#
# Logs: journalctl -u darkvoid-bot -f
#
# The app publishes port 8080 to the host via docker-compose.prod.yml, so the
# bot reaches it over localhost without joining the compose network.

[Unit]
Description=DarkVoid Gemini content bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple

# Secrets live in a root-only env file, never on the command line (arguments
# are world-readable via /proc). Required keys:
#   GEMINI_API_KEY        AI Studio key
#   BOT_RUNNER_PASSWORD   the account holding the 'bot' role
#   BOT_PASSWORD          shared by the persona accounts, registered on first run
EnvironmentFile=/etc/darkvoid-bot.env
Environment=BOT_API_BASE_URL=http://127.0.0.1:8080/api/v1
Environment=BOT_RUNNER_USERNAME=bot_runner

# No --interval or --accounts: post interval, persona count, model chain, personas,
# and topics come from GET /bot/plan and are edited in the admin panel, so changing
# behaviour no longer means editing this unit and reloading systemd.
ExecStart=/usr/local/bin/darkvoid-bot

Restart=on-failure
RestartSec=15s

# The bot only talks to the network; deny it everything else.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
